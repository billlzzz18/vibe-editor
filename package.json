{
  "name": "vibe-editor",
  "version": "1.0.0",
  "description": "Vibe Editor - AI-powered markdown editor with MCP support, glass morphism UI, and Thai language",
  "keywords": [
    "editor",
    "markdown",
    "ai",
    "mcp",
    "mistral",
    "typescript",
    "react",
    "tailwind",
    "shadcn",
    "glass-morphism",
    "thai-language"
  ],
  "homepage": "https://github.com/mistralai/vibe-editor#readme",
  "bugs": {
    "url": "https://github.com/mistralai/vibe-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mistralai/vibe-editor.git"
  },
  "license": "MIT",
  "author": "Mistral AI",
  "contributors": [],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "bun run src/server/index.ts",
    "server:dev": "bun run --watch src/server/index.ts",
    "mcp:server": "bun run src/lib/mcp/server.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"*.{json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --headed --debug",
    "test:api": "wait-on http://localhost:3001 && newman run tests/api/postman_collection.json",
    "test:e2e": "npm run server & wait-on http://localhost:3001 && playwright test",
    "test:all": "npm run lint && npm run typecheck && npm run format:check && npm run test && npm run test:ui",
    "clean": "rm -rf dist node_modules playwright-report test-results coverage",
    "prepare": "npm run clean && npm install"
  },
  "dependencies": {
    "@mistralai/mistralai": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@streamdown/streamdown": "^0.0.15",
    "@supabase/supabase-js": "^2.39.0",
    "@tiptap/extension-drag-and-drop": "^2.2.4",
    "@tiptap/extension-image": "^2.2.4",
    "@tiptap/extension-placeholder": "^2.2.4",
    "@tiptap/extension-task-item": "^2.2.4",
    "@tiptap/extension-task-list": "^2.2.4",
    "@tiptap/pm": "^2.2.4",
    "@tiptap/react": "^2.2.4",
    "@tiptap/starter-kit": "^2.2.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "hono": "^4.4.0",
    "lucide-react": "^0.323.0",
    "markdown-it": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-markdown": "^9.0.1",
    "shiki": "^1.3.0",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "tiptap-markdown": "^0.8.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.2",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/markdown-it": "^13.0.7",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.1.3",
    "@vitest/ui": "^1.1.3",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^23.0.1",
    "newman": "^5.3.2",
    "newman-reporter-html": "^1.0.5",
    "playwright": "^1.41.2",
    "postcss": "^8.4.33",
    "prettier": "^3.2.4",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.3.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wait-on": "^7.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0",
    "bun": ">=1.0.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ]
}
